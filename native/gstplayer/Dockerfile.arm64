# Dockerfile.arm64 - Cross-compile gstplayer for ARM64 (RK3562)
# GStreamer dev headers (amd64) are used for COMPILE only;
# symbols are resolved at runtime from the device's GStreamer 1.22 libs
# (linked with -Wl,-unresolved-symbols=ignore-all).

FROM ubuntu:22.04 AS builder

# Install cross-compilation toolchain + GStreamer dev headers (host arch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    cmake \
    make \
    git \
    ca-certificates \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source and iot-miniapp-sdk
COPY . .
# iot-miniapp-sdk via submodule or clone
RUN if [ ! -d "../iot-miniapp-sdk" ]; then \
      git clone --depth 1 https://github.com/ls-jl/WPE4YDPv2.git /tmp/WPE4YDPv2 && \
      cp -r /tmp/WPE4YDPv2/jsapi/iot-miniapp-sdk ../iot-miniapp-sdk; \
    fi

# Configure and build (minimal stub, no GStreamer dependency)
RUN cmake -B build \
    -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
    -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
    -DCMAKE_SYSTEM_NAME=Linux \
    -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
    -DCMAKE_BUILD_TYPE=Release .

RUN cmake --build build --config Release --parallel $(nproc)

# Verify output (file cmd not present in minimal image; use ls + hexdump via od)
RUN ls -la build/libjsapi_gstplayer.so && od -An -tx1 -N16 build/libjsapi_gstplayer.so